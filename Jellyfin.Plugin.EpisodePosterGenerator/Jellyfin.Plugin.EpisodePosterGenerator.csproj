<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.EpisodePosterGenerator</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Nullable>enable</Nullable>
    <AnalysisMode>AllEnabledByDefault</AnalysisMode>
    <CodeAnalysisRuleSet>../jellyfin.ruleset</CodeAnalysisRuleSet>
    <NoWarn>NU1605</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="10.11.0" />
    <PackageReference Include="Jellyfin.Model" Version="10.11.0" />
    <PackageReference Include="JPKribs.Jellyfin.Base" Version="2026.7.31" />
    <PackageReference Include="SkiaSharp" Version="2.88.8" />
    
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Primitives" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Jellyfin.Plugin.EpisodePosterGenerator.Tests" />
  </ItemGroup>

  <!--
    The base kit compiles every one of its shared sources into each consuming plugin. This plugin
    uses none of the status page helpers, and two of them carry [GeneratedRegex], which pulls the
    regex source generator's output into this assembly — where CodeQL then reports findings against
    machine generated code nobody here wrote. Dropping what is unused removes the generated file
    along with the dead code. FaviconResolver is self contained and TemplateLoader is used only by
    StatusPage, so the three come out together.
  -->
  <Target Name="RemoveUnusedBaseSources" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Compile Remove="@(Compile)"
               Condition="'%(Filename)' == 'FaviconResolver' Or '%(Filename)' == 'TemplateLoader' Or '%(Filename)' == 'StatusPage'" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <EmbeddedResource Include="Configuration\epg_posters.html" />
    <EmbeddedResource Include="Configuration\epg_posters.js" />
    <EmbeddedResource Include="Configuration\epg_settings.html" />
    <EmbeddedResource Include="Configuration\epg_settings.js" />
    <EmbeddedResource Include="Configuration\epg_shared.css" />
    <EmbeddedResource Include="Assets\Demo\demo-base.png" />
    <EmbeddedResource Include="Assets\Demo\demo-logo.png" />
    <EmbeddedResource Include="Assets\Demo\demo-graphic.png" />
    <EmbeddedResource Include="Assets\Demo\demo-poster.jpg" />
  </ItemGroup>

</Project>